{
  "//": "The app's in-page Worker (src/web/app): DOM code that imports the Worker, so it needs both sets of types.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src/web/app"]
}
